{
  "api_key": {
    "type": "string",
    "description": "Breeze API Key",
    "hint": "在 Breeze 开发者控制台创建，brz_ 开头",
    "default": "",
    "secret": true
  },
  "voice_id": {
    "type": "string",
    "description": "音色 ID",
    "hint": "voc_ 开头；可用 /breeze voices 关键词 搜索",
    "default": "voc_u3nxkd5578wc"
  },
  "auto_voice": {
    "type": "bool",
    "description": "全局语音回复",
    "hint": "开启后，所有 AI 文字回复会自动转成语音发送",
    "default": true
  },
  "speed": {
    "type": "float",
    "description": "语速",
    "hint": "0.5 - 2.0，默认 1.0",
    "default": 1.0
  },
  "language_code": {
    "type": "string",
    "description": "语言",
    "hint": "zh / en 等两位代码，默认 zh",
    "default": "zh"
  },
  "max_chars": {
    "type": "int",
    "description": "单条字数上限",
    "hint": "超过上限的回复保持文字发送，默认 200",
    "default": 200
  },
  "keep_text": {
    "type": "bool",
    "description": "同时保留文字",
    "hint": "开启后语音和原文一起发送",
    "default": false
  },
  "group_whitelist": {
    "type": "text",
    "description": "仅在这些群启用",
    "hint": "群号用英文逗号分隔；留空表示所有群",
    "default": ""
  },
  "base_url": {
    "type": "string",
    "description": "Breeze API 地址",
    "hint": "一般不用改",
    "default": "https://api.breeze.blue"
  }
}
